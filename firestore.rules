rules_version = '2';

// Open read/write rules for the accountability tracker.
// These do NOT auto-expire (unlike Firebase "test mode", which locks after
// 30 days). Anyone with the app's public config can read/write, so keep the
// link within your team. To lock this down later (anonymous auth required),
// just ask and the rules + app sign-in can be added.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if true;
    }
  }
}
